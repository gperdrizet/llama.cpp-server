                "--spec-draft-n-max": "3"
            }
        },
        {
            "label": "spec-nmax4",
            "flags": {
                "--model-draft":      "/models/Qwen3.8-27B-mtp-Q4_0.gguf",
                "--spec-type":        "draft-mtp",
                "--spec-draft-n-max": "4"
            }
        },
        {
            "label": "spec-nmax5",
            "flags": {
                "--model-draft":      "/models/Qwen3.8-27B-mtp-Q4_0.gguf",
