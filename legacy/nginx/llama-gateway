# Public LLM gateway (promptlyapi.com) -> LiteLLM router.
#
# All inbound LLM traffic on 8502 is proxied to the LiteLLM router
# container (Docker) on 127.0.0.1:8506. Model selection / routing now
# lives inside LiteLLM (templates/litellm_config.json.j2), so the old
# systemd/nginx profile-symlink mechanism (agent-router / pool / none,
# /etc/nginx/llama-profiles/active-profile.conf) is gone and no longer
# included here.
server {
    listen 8502;
    server_name localhost;

    # Fast, stable public health probe. LiteLLM's deep /health endpoint probes
    # every model and can run well past a health-checker's timeout; /health/readiness
    # (~5ms, 200 when the router can serve) is the right thing to expose publicly.
    location = /healthz {
        proxy_pass http://127.0.0.1:8506/health/readiness;
        proxy_http_version 1.1;
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:8506;
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 3600s; # holds long generations + queued requests
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
