[Unit]
Description=llama.cpp inference server (batch throughput instance)
Documentation=https://github.com/ggml-org/llama.cpp
After=network-online.target nvidia-persistenced.service
Wants=network-online.target nvidia-persistenced.service

[Service]
Type=simple
User=llama
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
Environment=CUDA_VISIBLE_DEVICES=SUB_CUDA_DEVICE_HERE
# Verbosity 4 prints the "load_tensors: offloaded X/Y layers to GPU" line, which
# is the only reliable way to confirm whether --fit silently sent layers to CPU.
Environment=LLAMA_ARG_LOG_VERBOSITY=4
Group=llama
CPUAffinity=SUB_CPU_AFFINITY_HERE
WorkingDirectory=SUB_LLAMA_PATH_HERE

# Tuned for overnight batch throughput (many short requests), not interactive
# latency: ctx-size sized to comfortably cover the observed max sequence length
# (prompt + generation, ~7.5k tokens) rather than the model's full 131072, and
# explicit batch/ubatch size + cont-batching to keep decode steps packed across
# slots. temp/top-p/top-k/min-p tuned low-variance for extraction, not creative
# "thinking mode" sampling.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do nvidia-smi -L > /dev/null 2>&1 && exit 0; sleep 1; done; exit 1'
ExecStart=SUB_LLAMA_PATH_HERE/build/bin/llama-server \
    -m SUB_MODEL_DIR_HERE/SUB_MODEL_FILE_HERE \
    --cache-type-k f16 \
    --cache-type-v f16 \
    --n-gpu-layers 999 \
    --split-mode none \
    --ctx-size SUB_CTX_SIZE_HERE \
    --parallel SUB_PARALLEL_HERE \
    --cont-batching \
    --batch-size 512 \
    --ubatch-size 512 \
    --kv-unified \
    --threads 12 \
    --threads-batch 12 \
    --flash-attn on \
    --fit-target 256 \
    --fit-ctx 16384 \
    --temp 0.2 \
    --top-p 1.0 \
    --top-k 0 \
    --min-p 0.0 \
    --jinja \
    --host 0.0.0.0 \
    --port SUB_PORT_HERE \
    --api-key SUB_API_KEY_HERE \
    --metrics \
    --log-timestamps \
    --log-prefix \
    --cache-ram -1

# Restart policy
Restart=on-failure
RestartSec=10
StartLimitInterval=300
StartLimitBurst=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=SUB_LLAMA_PATH_HERE SUB_MODEL_DIR_HERE

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=llama-server-batchSUB_INSTANCE_HERE

[Install]
WantedBy=multi-user.target
