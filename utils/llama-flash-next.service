[Unit]
Description=Llama.cpp Qwen3.8-Flash-Next (125B MoE, CPU-only) - long-horizon coding
After=network.target
Wants=network.target

[Service]
Type=simple
User=llama
Group=llama
# No GPU access at all — CPU-only by construction. Weights live in system
# RAM via mmap (178 GB Q8_0); the P100s stay free for the router/pool.
Environment=CUDA_VISIBLE_DEVICES=
ExecStart=/opt/llama.cpp/build/bin/llama-server \
    --model /home/siderealyear/llama.cpp/models/Qwen3.8-Flash-Next-Q8_0-00001-of-00006.gguf \
    --alias Qwen3.8-Flash-Next \
    --n-gpu-layers 0 \
    --host 127.0.0.1 \
    --port 8085 \
    --ctx-size 65536 \
    -np 1 \
    --threads 24 \
    --threads-batch 24 \
    --temp 1.0 \
    --top-p 0.95 \
    --top-k 20 \
    --min-p 0.0
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
