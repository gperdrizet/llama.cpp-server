# /etc/llama/llama-secrets.env - real API keys. NEVER commit this file.
#
# utils/deploy.sh scaffolds it from this example on first run, then stops so
# you can fill in the values. Keep it root-only: chown root:root, chmod 600.
#
# API key for the agent router (referenced as ${LLAMA_ROUTER_KEY} by
# agent-router.service).
LLAMA_ROUTER_KEY=
#
# Security line for the student pool replicas (expanded as $SECURITY by
# llama-pool@.service). Put the key between --api-key and --host.
SECURITY=--api-key  --host 127.0.0.1
