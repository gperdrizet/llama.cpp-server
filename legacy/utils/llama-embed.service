[Unit]
Description=Local embedding server (bge-m3, CPU)
After=network.target
Wants=network.target

[Service]
Type=simple
User=llama
Group=llama
# No GPU access at all — CPU-only by construction
Environment=CUDA_VISIBLE_DEVICES=
CPUAffinity=0-11
ExecStart=/opt/llama.cpp/build/bin/llama-server \
    --model /home/siderealyear/llama.cpp/models/bge-m3-Q8_0.gguf \
    --n-gpu-layers 0 \
    --port 8082 \
    --host 127.0.0.1 \
    --embedding \
    --ctx-size 4096 \
    --ubatch-size 1024
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
